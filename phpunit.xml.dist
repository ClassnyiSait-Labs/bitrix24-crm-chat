<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/10.5/phpunit.xsd"
         bootstrap="tests/bootstrap.php"
         colors="true"
         failOnWarning="true"
         cacheDirectory=".phpunit.cache">
    <testsuites>
        <testsuite name="unit">
            <directory suffix="Test.php">classnyisait.crmchat/test</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory suffix=".php">classnyisait.crmchat/lib</directory>
        </include>
    </source>
</phpunit>
